PORT=3100
HOST=127.0.0.1
# Chave longa e aleatória compartilhada APENAS entre o backend Trilha-4X4 e VERIS.
VERIS_API_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_LONGA
# Opcional: origens autorizadas para chamadas de navegador (separadas por vírgula).
CORS_ORIGINS=
# Opcional: provedor de modelo compatível com OpenAI. Sem chave, VERIS responde apenas com a base validada.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-20b
MODEL_TIMEOUT_MS=18000
