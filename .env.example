PORT=3100
HOST=127.0.0.1
# Chave longa e aleatória compartilhada APENAS entre o backend Trilha-4X4 e VERIS.
VERIS_API_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_LONGA
# Opcional: origens autorizadas para chamadas de navegador (separadas por vírgula).
CORS_ORIGINS=
# O motor de linguagem VERIS roda dentro desta aplicação e não usa API de IA externa.

# Ambiente público: NODE_ENV=production desabilita a interface de testes e impede a base experimental.
NODE_ENV=development
VERIS_DISABLE_TEST_UI=false
VERIS_ENABLE_TEST_KNOWLEDGE=false
# Chave administrativa separada da chave do aplicativo; mantenha vazia até precisar da API de administração.
VERIS_OWNER_API_KEY=
# Opcional: caminho local privado para feedback (não versionar nem enviar para logs).
VERIS_FEEDBACK_FILE=
