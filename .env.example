# VERIS central pessoal independente. Não usa as chaves do Trilha 4X4.
PORT=3100
HOST=127.0.0.1
# npm run setup configura senha e chave privada. Nunca versionar .env.
VERIS_PASSWORD_HASH=
VERIS_OWNER_API_KEY=
# Para HTTPS remoto: NODE_ENV=production e proxy HTTPS; cookies Secure.
NODE_ENV=development
VERIS_COOKIE_SECURE=false
# Só habilite em produção atrás de um proxy TLS confiável no mesmo computador.
VERIS_PUBLIC_TLS_TERMINATED=false
# Chaves APENAS de contas/projetos sem faturamento habilitado.
# A API não permite à VERIS comprovar o plano; confira no console do provedor.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
# Escolha um modelo com cota gratuita vigente em https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
# Limite LOCAL de tentativas total/dia (UTC), inclusive falhas/fallbacks.
VERIS_DAILY_AI_REQUESTS=30
# Ollama opcional: instale um modelo compatível com seu computador.
LOCAL_ENABLED=false
LOCAL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL=
# Banco privado (opcional, caminho local):
VERIS_DATA_FILE=
# OpenAI, Grok, Claude, mídia paga e anúncios pagos: desativados nesta versão.
